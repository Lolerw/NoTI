# Configuración de Base de Datos
# Local SQLite (Desarrollo):
DATABASE_URL=sqlite:///./noti_turnos.db

# Supabase (Producción - Connection Pooler puerto 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Configuración de Aplicación
APP_ENV=development # Cambiar a 'production' en Render
APP_PORT=8000
SECRET_KEY=noti-secret-key-super-secure-change-in-production

# Credenciales de Administrador Inicial en Producción (Opcional):
INITIAL_ADMIN_EMAIL=admin@noti.com
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=Admin123!
INITIAL_ADMIN_NAME="Administrador Principal"
